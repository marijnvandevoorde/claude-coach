# Training plans (generated files with date suffix like event-name-2026-03-28.json)
*-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].json
*-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].html

# Built template (generated from src/viewer via Vite)
templates/plan-viewer.html
cloud-output/
cloud-output/

# src/lib holds real source (config, logging, notify), not a build artifact —
# override the global ~/.gitignore_global "lib/" rule so new files here are tracked.
!src/lib/

# Docker deploy bundle — REAL secrets (.env), Garmin tokens, and a coach.db copy. Never commit.
docker_dist/

# ...but DO keep the committed env template (overrides the .env.* rule above).
!.env.example

# Global gitignore excludes any lib/ dir; the web app needs src/app/lib/
!src/app/lib/
!src/app/lib/**
