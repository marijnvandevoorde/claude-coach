# Claude Coach — Docker deployment env. Copy to `.env` and fill in (.env is gitignored).

# Timezone — the reminder schedule (07:30 / hourly / 22:00) fires in LOCAL time.
TZ=Europe/Brussels

# Inside-container paths (mounted from ./data) — usually leave as-is.
COACH_DB_PATH=/data/coach.db
GARMINTOKENS=/data/garminconnect

# Storage backend: "sqlite" (default, uses COACH_DB_PATH) or "mysql".
# For MySQL set COACH_DB_DRIVER=mysql and either COACH_DB_URL or the discrete vars.
# COACH_DB_DRIVER=mysql
# COACH_DB_URL=mysql://user:pass@host:3306/coach
# COACH_DB_HOST=127.0.0.1
# COACH_DB_PORT=3306
# COACH_DB_USER=coach
# COACH_DB_PASSWORD=
# COACH_DB_NAME=coach

# Push delivery. "webhook" POSTs {title,message} JSON to COACH_NOTIFY_WEBHOOK_URL
# (e.g. a Home Assistant webhook that fires a phone notification).
COACH_NOTIFY_CHANNEL=webhook
COACH_NOTIFY_WEBHOOK_URL=https://homeassistant.example/api/webhook/your-id?secret=changeme

# Reserved for a future authenticated HTTP/MCP endpoint — NOT used by the cron yet.
# If you later expose the coach over HTTP, this is the shared secret / bearer token.
COACH_AUTH_SECRET=generate-a-long-random-string

# Optional: override the reminder schedule (cron expressions, local time).
# COACH_GARMIN_FETCH_CRON=15 7 * * *   # pull live Garmin data just before the morning check-in
# COACH_MORNING_CRON=30 7 * * *
# COACH_HYDRATION_CRON=0 9-21 * * *
# COACH_BEDTIME_CRON=0 22 * * *

# The server-side Garmin fetcher (`garmin-fetch`) runs a bundled python script
# against Garmin Connect using the tokens in GARMINTOKENS. The image ships
# python3 + garminconnect, so leave this as-is; override only for a custom path.
# COACH_GARMIN_PYTHON=python3

# --- Tier 2: OAuth for the remote MCP (Google-federated, built into coach-mcp) ---
# Set ALL of these to enable OAuth (works on Desktop/web/mobile/Code; COACH_AUTH_SECRET is then ignored).
# The Google client's authorized redirect URI must be: <COACH_OAUTH_ISSUER>/oauth/google/callback
# COACH_OAUTH_ISSUER=https://coach.example.com         # this server's public base URL
# COACH_OAUTH_ALLOWED_EMAILS=you@example.com           # comma-separated allowlist
# COACH_OAUTH_SIGNING_SECRET=generate-a-long-random-string
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
