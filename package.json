{
  "name": "claude-coach",
  "version": "0.1.0",
  "author": "Felix Rieseberg <felix@felixrieseberg.com> (https://felixrieseberg.com)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-coach": "bin/claude-coach.js"
  },
  "files": [
    "bin",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.sql",
    "templates"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "npm run build:ts && npm run build:app && npm run build:viewer && npm run build:skill",
    "build:ts": "tsc && cp src/db/schema.sql src/db/schema.mysql.sql dist/db/",
    "build:app": "vite build --config vite.config.app.ts",
    "dev:app": "vite --config vite.config.app.ts",
    "build:viewer": "vite build --config vite.config.viewer.ts",
    "build:skill": "mkdir -p dist && cd skill && zip -r ../dist/coach-skill.zip . -x '*.DS_Store' && echo 'Skill packaged to dist/coach-skill.zip'",
    "build:website": "node scripts/build-website.js",
    "dev": "tsx watch src/cli.ts",
    "dev:viewer": "vite --config vite.config.viewer.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "deploy": "\"${SV_DEPLOY:-../Oracle/deploy/sv-deploy}\"",
    "deploy:check": "\"${SV_DEPLOY:-../Oracle/deploy/sv-deploy}\" --check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,html,css,svelte}": "prettier --write"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "consola": "^3.2.3",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "mysql2": "^3.24.6",
    "open": "^11.0.4",
    "undici": "^8.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
