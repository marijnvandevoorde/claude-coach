{
  "name": "claude-coach",
  "version": "0.1.0",
  "author": "Felix Rieseberg <felix@felixrieseberg.com> (https://felixrieseberg.com)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-coach": "bin/claude-coach.js"
  },
  "files": [
    "bin",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.sql",
    "templates"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "npm run build:ts && npm run build:app && npm run build:viewer && npm run build:skill",
    "build:ts": "tsc && cp src/db/schema.sql src/db/schema.mysql.sql dist/db/",
    "build:app": "vite build --config vite.config.app.ts",
    "dev:app": "vite --config vite.config.app.ts",
    "build:viewer": "vite build --config vite.config.viewer.ts",
    "build:skill": "mkdir -p dist && cd skill && zip -r ../dist/coach-skill.zip . -x '*.DS_Store' && echo 'Skill packaged to dist/coach-skill.zip'",
    "build:website": "node scripts/build-website.js",
    "dev": "tsx watch src/cli.ts",
    "dev:viewer": "vite --config vite.config.viewer.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,html,css,svelte}": "prettier --write"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.205.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "consola": "^3.2.3",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "mysql2": "^3.22.4",
    "open": "^11.0.0",
    "undici": "^8.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "svelte": "^5.56.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.8"
  }
}
