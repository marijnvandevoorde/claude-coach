# sv-deploy config: ships origin/main to the cluster sv-oke.
# See ../Oracle/deploy/README.md. Run: npm run deploy (or npm run deploy:check).
APP=claude-coach
# name|build context|Dockerfile|extra buildx args
IMAGES='
claude-coach|.|Dockerfile|
'
# One image, three Deployments (namespace/deployment/container=image)
TARGETS="apps/coach/coach=claude-coach apps/coach-app/coach-app=claude-coach apps/coach-mcp/coach-mcp=claude-coach"
# /health is coach-mcp's open health check; the app itself is behind login
SMOKE_URLS="https://coach.small-victories.co/health"
MANIFESTS="k8s/apps/tier2/stacks.py"
